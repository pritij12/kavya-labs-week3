# Copy this file to .env.local and fill it in. Never share .env.local

# Supabase database (supabase.com > your project > Connect)
# Transaction pooler, port 6543 (keep ?pgbouncer=true at the end)
DATABASE_URL="postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler or direct connection, port 5432 (used to create the tables)
DIRECT_URL="postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Local: http://localhost:3000   Vercel: your real address
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=any-long-random-text

# The Google email that becomes the first admin
ADMIN_EMAIL=you@gmail.com
